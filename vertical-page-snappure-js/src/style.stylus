random(min,max)
  return math(math(0, 'random') * (max - min + 1) + min, 'floor')

*
  box-sizing: border-box

body
  font: 50px 'Trebuchet MS', sans-serif

.gallery
  position: relative

.gallery-scroller
  display: flex
  align-items: center
  flex-direction: column
  height: 100vh
  overflow-x: hidden
  overflow-y: scroll
  scroll-snap-type: y mandatory
  
.gallery-item
  position: relative
  display: flex
  align-items: center
  justify-content: center
  width: 100vw
  min-width: 100%
  min-height: 100%
  background-color: #baf4ba
  scroll-snap-align: center

for i in (1..12)
  .gallery-item:nth-child({i})
    filter: hue-rotate(random(30, 350)deg)

    
.pagination
  position: fixed
  top: 50%
  right: 10px
  width: 20px
  transform: translateY(-50%)

.pagination-item
  height: 20px
  margin-bottom: 5px
  position: relative
  cursor: pointer

  &:last-child
    margin-bottom: 0

  &:after
    content: ''
    position: absolute
    top: 0
    right: 4px
    bottom: 0
    width: 10px
    height: 10px
    margin: auto
    border: 1px solid
    border-radius: 50%
    transition: box-shadow 0.3s ease

  &.active:after
    box-shadow: inset 0 0 0 5px
  
